# Partner squad — copy to `.env` (do not commit real secrets)
# Keys come from humans (FastOps onboarding / Joel), not from an AI.

# Inbound: must match the value FastOps sends in `x-pt-api-key` when they POST to you
PT_SHARED_SECRET=

# Server
PORT=3000

# Outbound to FastOps — only if your app or scripts call api.fastops.ai
FASTOPS_API_KEY=
FASTOPS_API_BASE_URL=https://api.fastops.ai
