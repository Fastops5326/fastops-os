{
  "name": "fastops-development-process",
  "version": "1.0.0",
  "description": "FastOps Development Process - Build proof-of-concept prototypes in <60 minutes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fastops": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "claude": "node .fastops/pty-claude.js",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/index.ts --validate",
    "test": "node .fastops/test-cdp-stack.js --skip-cdp",
    "test:cdp": "node .fastops/test-cdp-stack.js",
    "test:cdp:deep": "node .fastops/test-cdp-stack.js --deep",
    "perplexity:ask": "node .fastops/perplexity-query-repo.js",
    "repo:index": "node .fastops/repo-index/build-repo-index.js",
    "test:perplexity": "node missions/the-shape/test-perplexity.js",
    "mcp:apply-forge": "node missions/the-shape/mcp-apply-operations.js",
    "mcp:loop": "node missions/the-shape/mcp-continuous-loop.js",
    "mcp:perplexity-smoke": "node missions/the-shape/mcp-perplexity-path-validation.js",
    "test:comms-loop": "node comms/verify-two-way-loop.js --simulate",
    "test:comms-loop:live": "node comms/verify-two-way-loop.js",
    "test:comms": "node .fastops/test-cdp-stack.js && node comms/verify-two-way-loop.js --unattended",
    "prove:comms-2way": "node comms/verify-two-way-loop.js",
    "prove:comms-2way:unattended": "node comms/verify-two-way-loop.js --unattended",
    "prove:comms-2way:cursor": "node comms/verify-two-way-loop.js --cursor-ack",
    "interview": "tsx src/interview-v2/run-interview.ts",
    "interview:web": "tsx src/interview-v2/web/server.ts",
    "flash:web": "tsx src/web/server.ts",
    "cli": "tsx src/cli/main.ts",
    "fastops": "tsx src/cli/main.ts",
    "dashboard": "node dashboard/server.js",
    "joel": "start /b node .fastops/haiku-sentry.js && node .fastops/thinking-partner.js",
    "docx:gerry-appendix": "node deliverables/md-to-docx.js deliverables/GERRY-MSTL-TECHNICAL-APPENDIX.md deliverables/GERRY-MSTL-TECHNICAL-APPENDIX.docx --copy-downloads",
    "comms:read": "node comms/read.js 25",
    "comms:poll": "node comms/poll-loop.js",
    "freedom:peer-ping": "node comms/peer-ping.js",
    "comms:brief": "node comms/source.js --all-channels",
    "comms:cdp-claude": "node comms/cdp-to-claude.js",
    "comms:cdp-claude-code": "node comms/cdp-to-claude-code.js",
    "comms:harvest-claude-code": "node .fastops/claude-code-comms-harvest.js",
    "comms:anthropic-stream": "node comms/anthropic-stream-bridge.js",
    "cadence:pulse": "node .fastops/cadence-pulse.js",
    "cadence:once": "node .fastops/cadence-pulse.js --once",
    "cadence:ensure": "node .fastops/cadence-pulse.js --ensure",
    "comms:engage-cadence": "node .fastops/cdp/engage-last-cadence.js --print-cmd",
    "cadence:engage-watch": "node .fastops/cdp/cadence-engage-watch.js",
    "cadence:engage-nudge": "node .fastops/cdp/cadence-engage-watch.js --nudge",
    "measure:framing": "node .fastops/measure-framing-ab.js",
    "crosscheck:status": "node .fastops/auto-crosscheck.js --status",
    "cdp:verify": "node .fastops/cdp-verify.js",
    "cdp:verify:strict": "node .fastops/cdp-verify.js --strict",
    "cdp:compact": "node .fastops/cdp-compact-request.js",
    "cdp:compact:validate": "node .fastops/cdp-compact-request.js --validate",
    "handoff:self-compact": "node .fastops/handoff-self-compact.js",
    "slack:sync": "node slack-bridge/sync.js",
    "slack:sync:cdp": "node slack-bridge/sync.js --cdp",
    "slack:watch": "node slack-bridge/sync.js --watch 10",
    "slack:watch:cdp": "node slack-bridge/sync.js --watch 10 --cdp",
    "overwatch:brief": "node .fastops/overwatch-briefing.js",
    "overwatch:brief:json": "node .fastops/overwatch-briefing.js --json",
    "overwatch:brief:arc20": "node .fastops/overwatch-briefing.js --arc 20",
    "overwatch:selfwake": "node .fastops/overwatch-cdp-selfwake.js --help",
    "cdp:comms-watch": "node .fastops/cdp/cdp-comms-watch.js",
    "cdp:comms-watch:ensure": "node .fastops/ensure-comms-watch.js",
    "cdp:comms-watch:status": "node .fastops/ensure-comms-watch.js --status",
    "cdp:comms-watch:stop": "node .fastops/ensure-comms-watch.js --stop",
    "cdp:wake-all": "node .fastops/cdp/cdp-wake-all.js",
    "cdp:screenshot-agents": "node .fastops/cdp/cursor-agents-screenshot.js",
    "cdp:await-peer": "node .fastops/cdp/cdp-await-peer-comms.js",
    "cdp:cursor-all-ack": "node .fastops/cdp/cdp-cursor-until-all-ack.js",
    "cdp:composer-peers": "node .fastops/cdp/cdp-list-composer-peers.js",
    "wake:claude-code-watch": "node .fastops/comms-wake-claude-code.js --watch",
    "wake:claude-code-poll": "node .fastops/comms-wake-claude-code.js --interval 5000"
  },
  "keywords": [
    "fastops",
    "rapid-prototyping",
    "ai-development",
    "wave-programming"
  ],
  "author": "FastOps.ai",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/uuid": "^10.0.0",
    "screenshot-desktop": "^1.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.103.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "nats": "^2.29.3",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.2",
    "playwright": "^1.58.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.39.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  }
}
